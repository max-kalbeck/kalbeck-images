<https://id.acdh.oeaw.ac.at/dboe-tei-xml> a acdh:TopCollection ;
    acdh:hasTitle """Kalbeck Tagebuch"""@de ;
    acdh:hasTitle """Kalbeck Tagebuch"""@en ;
    acdh:hasDescription """Diese Sammlung enthält die Scans der Tagebücher von Max Kalbeck der Jahre 1895/1897"""@de;
    acdh:hasDescription """This collection contains the scans of Max Kalbeck’s diaries from the years 1895/1897."""@en;
    acdh:hasTemporalCoverage "Die Tagebücher behandeln die Jahre 1895 und 1897."@de ;
    acdh:hasTemporalCoverage "The diaries cover the years 1895 and 1897."@en ;
